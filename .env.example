# Copie este arquivo para ".env" e preencha os valores.
# O ".env" nunca deve ser versionado — já está no .gitignore.

# =================================================================
# FRONTEND (site)
#
# Tudo que começa com VITE_ é embutido no JavaScript e FICA VISÍVEL
# no navegador. Só coloque aqui o que pode ser público.
# NUNCA coloque a service role key nem a senha do painel em VITE_.
# =================================================================

# Endereço da API. Ex.: https://api-programa.onrender.com
# Deixe vazio em desenvolvimento (o Vite faz proxy de /api para localhost:3001).
VITE_API_URL=

# =================================================================
# BACKEND (pasta server/)
#
# Variáveis privadas. Ficam só no servidor que roda a API —
# nunca no Netlify, nunca no navegador.
# =================================================================

# --- Supabase -----------------------------------------------------
# Project URL: Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# service_role key: Supabase → Project Settings → API → Project API keys
# ATENÇÃO: esta chave ignora todas as regras de segurança do banco.
# Ela vale como uma senha de administrador. Nunca exponha no frontend,
# não versione e não compartilhe.
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais — só mude se tiver usado outros nomes no Supabase.
# SUPABASE_TABELA=inscricoes
# SUPABASE_BUCKET_FOTOS=fotos-candidatos
# SUPABASE_BUCKET_CURRICULOS=curriculos-candidatos

# --- Painel administrativo ---------------------------------------
# Senha de acesso ao /admin.
ADMIN_PASSWORD=

# Segredo que assina o token de sessão do painel.
# Gere um valor aleatório:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# Nome de quem opera o painel. Fica gravado em "excluída por" quando uma
# inscrição é excluída. Opcional — sem ele, o registro sai como "admin".
# O acesso é por senha única, então não há como distinguir uma pessoa da outra.
# ADMIN_NOME=

# =================================================================
# AVISO DE NOVA INSCRIÇÃO POR E-MAIL
#
# Opcional. Sem configurar, as inscrições continuam funcionando
# normalmente — a API só registra no log que o aviso está desligado.
# =================================================================

# Para onde vai o aviso. Aceita vários separados por vírgula.
NOTIFICATION_EMAIL=

# Quem envia. Precisa ser um remetente autorizado no provedor.
# Ex.: Programa de Formação <inscricoes@seudominio.com.br>
EMAIL_FROM=

# resend | smtp | none
# none (padrão) = aviso desligado.
EMAIL_PROVIDER=none

# --- Se EMAIL_PROVIDER=resend ------------------------------------
# Chave da API em https://resend.com → API Keys
# RESEND_API_KEY=

# --- Se EMAIL_PROVIDER=smtp --------------------------------------
# Dados do servidor de e-mail. A porta 465 usa TLS direto; a 587, STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Endereço do painel, usado no botão do e-mail.
# Sem isto, o link é montado a partir do primeiro domínio do CORS_ORIGIN.
# Ex.: https://programa-formacao.netlify.app/admin
# ADMIN_PANEL_URL=

# --- Servidor -----------------------------------------------------
# Porta da API (padrão 3001).
PORT=3001

# Domínios autorizados a chamar a API, separados por vírgula.
# Em produção, coloque o endereço do site no Netlify.
# Ex.: https://programa-formacao.netlify.app
CORS_ORIGIN=
