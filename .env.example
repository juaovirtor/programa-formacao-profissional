# Copie este arquivo para ".env" e preencha os valores.
# O ".env" nunca deve ser versionado — já está no .gitignore.

# =================================================================
# FRONTEND (site)
#
# Tudo que começa com VITE_ é embutido no JavaScript e FICA VISÍVEL
# no navegador. Só coloque aqui o que pode ser público.
# NUNCA coloque a service role key nem a senha do painel em VITE_.
# =================================================================

# Endereço da API. Ex.: https://api-programa.onrender.com
# Deixe vazio em desenvolvimento (o Vite faz proxy de /api para localhost:3001).
VITE_API_URL=

# =================================================================
# BACKEND (pasta server/)
#
# Variáveis privadas. Ficam só no servidor que roda a API —
# nunca no Netlify, nunca no navegador.
# =================================================================

# --- Supabase -----------------------------------------------------
# Project URL: Supabase → Project Settings → API → Project URL
SUPABASE_URL=

# service_role key: Supabase → Project Settings → API → Project API keys
# ATENÇÃO: esta chave ignora todas as regras de segurança do banco.
# Ela vale como uma senha de administrador. Nunca exponha no frontend,
# não versione e não compartilhe.
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais — só mude se tiver usado outros nomes no Supabase.
# SUPABASE_TABELA=inscricoes
# SUPABASE_BUCKET_FOTOS=fotos-candidatos
# SUPABASE_BUCKET_CURRICULOS=curriculos-candidatos

# --- Painel administrativo ---------------------------------------
# Senha de acesso ao /admin.
ADMIN_PASSWORD=

# Segredo que assina o token de sessão do painel.
# Gere um valor aleatório:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# --- Servidor -----------------------------------------------------
# Porta da API (padrão 3001).
PORT=3001

# Domínios autorizados a chamar a API, separados por vírgula.
# Em produção, coloque o endereço do site no Netlify.
# Ex.: https://programa-formacao.netlify.app
CORS_ORIGIN=
